<launch>

  <group ns="turtlesim1">
    <node pkg="turtlesim" name="turtle1" type="turtlesim_node"/>
  </group>

  <group ns="turtlesim2">
    <node pkg="turtlesim" name="turtle2" type="turtlesim_node">
	<remap from="turtle1/cmd_vel" to="/turtlesim2/turtle2/cmd_vel"/>
	<remap from="turtle1/pose" to="/turtlesim2/turtle2/pose"/>
	<remap from="turtle1/color_sensor" to="/turtlesim2/turtle2/color_sensor"/>
    </node>
  </group>
  <node pkg="turtlesim" name="teleoperation" type="turtle_teleop_key">
    <remap from="turtle1/cmd_vel" to="/turtlesim1/turtle1/cmd_vel"/>
  </node>
  <node pkg="turtlesim" name="mimic" type="mimic">
    <remap from="input" to="/turtlesim1/turtle1"/>
    <remap from="output" to="/turtlesim2/turtle2"/>
  </node>

</launch>

